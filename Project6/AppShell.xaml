<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Project6.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Project6.Views"
    Title="Project6"
    Shell.TabBarBackgroundColor="#FDF8F5"
    Shell.TabBarTitleColor="#8D5B4C"
    Shell.TabBarUnselectedColor="#BDB7B3">
    <TabBar>
        <Tab Title="Послуги" Icon="{x:Null}">
            <ShellContent ContentTemplate="{DataTemplate views:ServicesPage}" />
        </Tab>
        <Tab Title="Мої Записи" Icon="{x:Null}">
            <ShellContent ContentTemplate="{DataTemplate views:BookingsPage}" />
        </Tab>
    </TabBar>
</Shell>